{
  "name": "@modelfaucet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json --noEmit && node ../../scripts/build-node-service.mjs src/index.ts dist/index.js",
    "verify:dist": "node -e \"import('./dist/index.js')\"",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@modelfaucet/shared": "workspace:^",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
