# ModelFaucet hosted beta environment template.
# Keep real values in a secret manager or private deployment environment, never in git.

NODE_ENV=production
HOSTED_ENVIRONMENT=staging
HOSTED_SECRET_MANAGER=example-secret-manager
# Copy these exact name@sha256 references from the container-images workflow artifacts.
MODELFAUCET_API_IMAGE=ghcr.io/hiclawbot/modelfaucet-api@sha256:REPLACE_WITH_64_HEX_DIGEST
MODELFAUCET_GATEWAY_IMAGE=ghcr.io/hiclawbot/modelfaucet-gateway@sha256:REPLACE_WITH_64_HEX_DIGEST
MODELFAUCET_DASHBOARD_IMAGE=ghcr.io/hiclawbot/modelfaucet-dashboard@sha256:REPLACE_WITH_64_HEX_DIGEST

# Public HTTPS endpoints used for CORS, links, and smoke checks.
API_PUBLIC_BASE_URL=https://api.modelfaucet.example
DASHBOARD_PUBLIC_APP_ID=app_public_id_from_operator_bootstrap
GATEWAY_PUBLIC_BASE_URL=https://gateway.modelfaucet.example/v1
DASHBOARD_PUBLIC_BASE_URL=https://dashboard.modelfaucet.example
PUBLIC_SUPPORT_URL=https://modelfaucet.example/support

# Database and internal service URLs.
DATABASE_URL=
REDIS_URL=redis://redis:3290
LITELLM_BASE_URL=https://litellm.modelfaucet.example

# Required server-side secrets. Do not put these in browser-visible Vite env vars.
# DEVELOPER_ADMIN_TOKEN is bootstrap/operator only; create scoped mf_dev_ tokens for production developer workflows.
SECRET_ENCRYPTION_KEY=
ADMIN_TOKEN=
DEVELOPER_ADMIN_TOKEN=
LITELLM_MASTER_KEY=
METRICS_TOKEN=

# Explicit production CORS allowlists. Do not use '*'.
API_CORS_ORIGINS=https://dashboard.modelfaucet.example,https://crm-demo.modelfaucet.example
GATEWAY_CORS_ORIGINS=https://crm-demo.modelfaucet.example

# Provider keys are server-side only and optional until real provider pilot traffic starts.
REQUIRE_HOSTED_PROVIDER=0
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Stripe keys are server-side only and optional until hosted Stripe top-ups are enabled.
REQUIRE_HOSTED_STRIPE=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public contact paths required before hosted pilot onboarding.
SECURITY_CONTACT_EMAIL=security@modelfaucet.example
ABUSE_CONTACT_EMAIL=abuse@modelfaucet.example
INCIDENT_CONTACT_EMAIL=incident@modelfaucet.example

# Operational policy defaults.
PAYOUT_THRESHOLD_USD=25.00000000
API_RATE_LIMIT_MAX_REQUESTS=1200
API_RATE_LIMIT_WINDOW_MS=60000
API_SESSION_RATE_LIMIT_MAX_REQUESTS=60
API_SESSION_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX_REQUESTS=1200
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_MS=250
# Authoritative platform pricing. Verify against the selected provider before pilot traffic.
GATEWAY_PLATFORM_MODEL=auto-text
GATEWAY_PLATFORM_INPUT_PRICE_PER_1M_TOKENS_USD=1.00000000
GATEWAY_PLATFORM_OUTPUT_PRICE_PER_1M_TOKENS_USD=2.00000000
GATEWAY_PLATFORM_MARKUP_PERCENT=30
GATEWAY_PLATFORM_MAX_INPUT_TOKENS=8192
GATEWAY_PLATFORM_MAX_OUTPUT_TOKENS=1024
GATEWAY_RESERVATION_TTL_MS=120000
TRUST_PROXY_HOPS=1

# First-Beta capability boundary. hosted:verify-env requires these exact values.
API_PLATFORM_ONLY=1
GATEWAY_PLATFORM_ONLY=1
API_ENABLE_STRIPE_PAYMENTS=0
API_ENABLE_PAYOUTS=0
API_ENABLE_PROVIDER_KEYS=0
API_ENABLE_TEST_CREDITS=0
API_REQUIRE_SESSION_ORIGIN=1

# One-time/idempotent pilot bootstrap inputs. Keep the app ID aligned with
# DASHBOARD_PUBLIC_APP_ID; bootstrap creates no credits or end users.
BOOTSTRAP_DEVELOPER_NAME=Pilot Developer
BOOTSTRAP_DEVELOPER_EMAIL=pilot@modelfaucet.example
BOOTSTRAP_APP_PUBLIC_ID=app_public_id_from_operator_bootstrap
BOOTSTRAP_APP_NAME=Pilot App
BOOTSTRAP_APP_VERTICAL=productivity
BOOTSTRAP_REVENUE_SHARE_BPS=4000
BOOTSTRAP_APP_ALLOWED_ORIGINS=https://pilot.modelfaucet.example
BOOTSTRAP_APP_MONTHLY_SPEND_LIMIT_USD=25.00000000
BOOTSTRAP_SESSION_SPEND_LIMIT_USD=2.00000000
