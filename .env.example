NODE_ENV=development
PORT_API=3201
PORT_GATEWAY=3202
DATABASE_URL=postgresql://modelfaucet:modelfaucet@localhost:3200/modelfaucet
REDIS_URL=redis://localhost:3290

JWT_SECRET=dev_only_replace_me
ADMIN_TOKEN=mf_admin_dev
# Bootstrap/operator only. Use POST /v1/developer/tokens to create scoped mf_dev_ tokens for production developer access.
DEVELOPER_ADMIN_TOKEN=mf_admin_dev
METRICS_TOKEN=mf_metrics_dev
TRUST_PROXY_HOPS=0
API_PLATFORM_ONLY=0
API_ENABLE_STRIPE_PAYMENTS=1
API_ENABLE_PAYOUTS=1
API_ENABLE_PROVIDER_KEYS=1
API_ENABLE_TEST_CREDITS=1
API_REQUIRE_SESSION_ORIGIN=0
SESSION_TOKEN_TTL_SECONDS=3600
API_RATE_LIMIT_MAX_REQUESTS=1200
API_RATE_LIMIT_WINDOW_MS=60000
API_SESSION_RATE_LIMIT_MAX_REQUESTS=60
API_SESSION_RATE_LIMIT_WINDOW_MS=60000
# Comma-separated origins. Required in production; development may omit for demo CORS.
API_CORS_ORIGINS=http://localhost:3203,http://127.0.0.1:3203

LITELLM_BASE_URL=http://localhost:3205
LITELLM_MASTER_KEY=sk-litellm-dev-master-key
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_MS=250
# Authoritative server-side Beta route and retail pricing policy.
GATEWAY_PLATFORM_MODEL=auto-text
GATEWAY_PLATFORM_INPUT_PRICE_PER_1M_TOKENS_USD=1.00000000
GATEWAY_PLATFORM_OUTPUT_PRICE_PER_1M_TOKENS_USD=2.00000000
GATEWAY_PLATFORM_MARKUP_PERCENT=30
GATEWAY_PLATFORM_MAX_INPUT_TOKENS=8192
GATEWAY_PLATFORM_MAX_OUTPUT_TOKENS=1024
GATEWAY_RESERVATION_TTL_MS=120000
GATEWAY_PLATFORM_ONLY=0
GATEWAY_RATE_LIMIT_MAX_REQUESTS=1200
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Comma-separated origins. Required in production; development may omit for demo CORS.
GATEWAY_CORS_ORIGINS=http://localhost:3203,http://127.0.0.1:3203

VITE_MODELFAUCET_API_BASE_URL=http://localhost:3201
VITE_MODELFAUCET_GATEWAY_BASE_URL=http://localhost:3202/v1
# Do not set VITE_MODELFAUCET_DEVELOPER_TOKEN or VITE_MODELFAUCET_DEVELOPER_ADMIN_TOKEN in public hosted dashboard builds.

# Server-side only. Never expose to SDK/client bundles.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Dev mode only. Production must use KMS/Vault/Secret Manager.
SECRET_ENCRYPTION_KEY=dev_32_bytes_replace_me_replace_me

# Stripe test mode, optional for phase 5.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

PAYOUT_THRESHOLD_USD=1.00000000
