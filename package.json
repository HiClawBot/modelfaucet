{
  "name": "modelfaucet",
  "private": true,
  "version": "1.3.0-beta.1",
  "description": "Open-source LLM distribution gateway and embeddable SDK for turning every app into an AI last-mile channel.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "pnpm lint:ts && pnpm lint:go",
    "lint:ts": "turbo run lint",
    "lint:go": "test -z \"$(gofmt -l services/local-bridge)\"",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:go",
    "typecheck:ts": "turbo run typecheck",
    "typecheck:go": "cd services/local-bridge && go test ./...",
    "test": "pnpm test:ts && pnpm test:go && pnpm test:hosted-canary",
    "test:ts": "turbo run test",
    "test:go": "cd services/local-bridge && go test ./...",
    "test:hosted-canary": "node --test scripts/test/hosted-canary.test.mjs",
    "verify:secrets": "node scripts/verify-no-real-secrets.mjs",
    "ga:verify": "node scripts/verify-ga-readiness.mjs",
    "release:verify": "node scripts/verify-release-candidate.mjs",
    "compose:verify": "node scripts/verify-compose-config.mjs",
    "container:verify": "node scripts/verify-container-publishing.mjs",
    "deps:review": "pnpm outdated -r",
    "hosted:verify-env": "node scripts/verify-hosted-env.mjs",
    "hosted:check-isolation": "node scripts/check-tenant-isolation.mjs",
    "hosted:check-operations": "node scripts/check-beta-operations.mjs",
    "hosted:smoke-readiness": "node scripts/smoke-hosted-readiness.mjs",
    "hosted:smoke-canary": "node scripts/smoke-hosted-canary.mjs",
    "hosted:soak": "node scripts/soak-hosted-canary.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 3207",
    "docs:build": "node ./node_modules/vitepress/bin/vitepress.js build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 3208",
    "website:build": "pnpm --filter @modelfaucet/website build",
    "dashboard:smoke-runtime": "node scripts/smoke-dashboard-runtime.mjs",
    "pages:build": "node scripts/build-pages-site.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:migration:plan": "node scripts/migrate-db.mjs --plan",
    "db:verify-migrations": "node scripts/verify-db-migrations.mjs",
    "db:seed": "psql $DATABASE_URL -f infra/db/seed.sql",
    "db:bootstrap:production": "node scripts/bootstrap-production.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore:verify": "node scripts/verify-db-restore.mjs",
    "db:reset:dev": "node scripts/reset-dev-db.mjs",
    "stripe:webhook:replay": "node scripts/replay-stripe-webhook.mjs",
    "smoke:local": "node scripts/smoke-local-stack.mjs",
    "smoke:local:production": "node scripts/smoke-local-stack.mjs --production",
    "smoke:provider": "node scripts/smoke-provider-route.mjs"
  },
  "keywords": [
    "llm",
    "ai-gateway",
    "byok",
    "usage-based-billing",
    "revenue-sharing",
    "openai-compatible"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
